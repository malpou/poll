package views

// Lucide icons, inlined as SVG with the 24x24 viewBox and stroke settings Lucide
// ships. Inlined rather than pulled from a package: it's a dozen paths, and this
// keeps the icons out of the dependency tree.

templ icon(size int, paths templ.Component) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width={ size }
		height={ size }
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		class="shrink-0"
		aria-hidden="true"
	>
		@paths
	</svg>
}

templ pathsCheck() {
	<path d="M20 6 9 17l-5-5"></path>
}

templ pathsSend() {
	<path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path>
	<path d="m21.854 2.147-10.94 10.939"></path>
}

templ pathsCopy() {
	<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
	<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
}

templ pathsX() {
	<path d="M18 6 6 18"></path>
	<path d="m6 6 12 12"></path>
}

templ pathsPencil() {
	<path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"></path>
	<path d="m15 5 4 4"></path>
}

templ pathsPlus() {
	<path d="M5 12h14"></path>
	<path d="M12 5v14"></path>
}

templ pathsLock() {
	<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
	<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
}

templ pathsLockOpen() {
	<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
	<path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
}

templ pathsTriangleAlert() {
	<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
	<path d="M12 9v4"></path>
	<path d="M12 17h.01"></path>
}

templ pathsChevronUp() {
	<path d="m18 15-6-6-6 6"></path>
}

templ pathsChevronDown() {
	<path d="m6 9 6 6 6-6"></path>
}

templ pathsMessageSquare() {
	<path d="M22 17a2 2 0 0 1-2 2H6l-4 4V4a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path>
}

templ iconCheck(size int) {
	@icon(size, pathsCheck())
}

templ iconSend(size int) {
	@icon(size, pathsSend())
}

templ iconCopy(size int) {
	@icon(size, pathsCopy())
}

templ iconX(size int) {
	@icon(size, pathsX())
}

templ iconPencil(size int) {
	@icon(size, pathsPencil())
}

templ iconPlus(size int) {
	@icon(size, pathsPlus())
}

templ iconLock(size int) {
	@icon(size, pathsLock())
}

templ iconLockOpen(size int) {
	@icon(size, pathsLockOpen())
}

templ iconTriangleAlert(size int) {
	@icon(size, pathsTriangleAlert())
}

templ iconChevronUp(size int) {
	@icon(size, pathsChevronUp())
}

templ iconChevronDown(size int) {
	@icon(size, pathsChevronDown())
}

templ iconMessageSquare(size int) {
	@icon(size, pathsMessageSquare())
}
