{
	// The app is Go. TypeScript now covers only the Playwright specs and the
	// Paraglide-compiled messages they import.
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": ["ES2022", "DOM"],
		"allowJs": true,
		"checkJs": false,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"moduleResolution": "bundler",
		"types": ["node"]
	},
	"include": [
		"e2e/**/*.ts",
		"src/lib/types.ts",
		"src/lib/paraglide/**/*.js",
		"playwright.config.ts"
	],
	// Paraglide's generated server.js targets a Request type we never use - the app
	// resolves locale in Go. The typed m.*() functions are still available.
	"exclude": ["src/lib/paraglide/server.js"]
}
